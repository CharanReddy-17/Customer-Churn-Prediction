# .dockerignore
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Data (mount as volume in production)
data/

# MLflow runs (large, not needed in container)
mlruns/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Monitoring reports (generated at runtime)
monitoring/reports/

# SQLite database (generated at runtime)
*.db

# Git
.git/
.gitignore

# Docs
README.md
*.md
